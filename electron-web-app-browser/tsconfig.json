{
  "compilerOptions": {
    "target": "ES6",
    "allowJs": true,
    "module": "esnext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "app/*": ["./src/*"]
    },
    "types": [
      "vite",
      "jest"
    ]
  },
  "include": [
    "vite.main.config.mts",
    "vite.preload.config.mts",
    "vite.renderer.config.mts",
    "vite.settings.renderer.config.mts",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"],
  "files":[
   "src/global.d.ts"
  ]
}
